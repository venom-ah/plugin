{
  "enabled": true,
  "name": "Venom brain — session start",
  "description": "Ask Venom for shared organization guidance at session start.",
  "version": "1",
  "when": {
    "type": "sessionStart"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Using the venom MCP server, call its read tool with path \"hooks/session-start.md\" and follow that guidance for this session. If the file does not exist, continue silently without mentioning it."
  }
}
