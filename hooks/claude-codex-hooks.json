{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/venom-context.js\" SessionStart",
            "timeout": 5,
            "statusMessage": "Loading Venom context guidance..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/venom-context.js\" SubagentStart",
            "timeout": 5,
            "statusMessage": "Loading Venom context guidance..."
          }
        ]
      }
    ]
  }
}
